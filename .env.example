# Copier ce fichier en .env sur le serveur (jamais dans Git) : cp .env.example .env

# Premier compte administrateur, créé au premier démarrage si la base n'a aucun compte.
# Une fois connecté, vous pouvez vider ADMIN_PASSWORD.
ADMIN_USER=arthur
ADMIN_PASSWORD=changez-moi

# Clé qui chiffre les clés API enregistrées par les utilisateurs.
# Générez-la une fois : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Si vous la changez, les clés API enregistrées deviennent illisibles (à ressaisir).
SECRET_KEY=

# Optionnel : services en plus sur la page Admin (nom=url, séparés par des virgules)
# HEALTH_URLS=open-webui=http://open-webui:8080
